# ==============================================================================
# Shroud's Lockin Crib (SLC) — Vercel Production Environment Configuration
# ==============================================================================
# Use this template for Vercel: Project Dashboard -> Settings -> Environment Variables
# Or paste these variables directly via Vercel's "Paste .env contents" option.
#
# NOTE: Replace placeholder values (...) with your actual configuration before pasting.
# ==============================================================================

# Core Application Environment
FLASK_ENV=production

# Application Secret Key (64-character random hex string)
# Generate locally: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=...

# Render PostgreSQL Database Connection (External URL + SSL mode required)
# Format: postgresql://<user>:<password>@<external-host>.render.com/<dbname>?sslmode=require
# Must use the external hostname (...postgres.render.com), NOT the internal dpg-... hostname.
DATABASE_URL=postgresql://...

# Security & Session Configuration (Enforces HTTPS cookies on Vercel)
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_DAYS=7

# Serverless File Storage (Vercel provides /tmp for ephemeral writable storage)
UPLOAD_FOLDER=/tmp/uploads
MAX_CONTENT_LENGTH=16777216
ALLOWED_EXTENSIONS=png,jpg,jpeg,webp,gif

# Rate Limiting Settings
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_CHAT=1/second
RATE_LIMIT_AI=10/minute

# AI Productivity Assistant (Default is 'heuristic' which requires no external API keys)
# Optional: Set AI_PROVIDER to 'gemini' or 'openai' and provide the corresponding API key.
AI_PROVIDER=heuristic
OPENAI_API_KEY=
GEMINI_API_KEY=
