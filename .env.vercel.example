# ==============================================================================
# Shroud's Lockin Crib (SLC) — Vercel Environment Variables
# ==============================================================================
# In Vercel: Project Dashboard -> Settings -> Environment Variables
# Add each variable below for Production, Preview, and Development.
# ==============================================================================

# 1. Flask Application Environment
FLASK_ENV=production
FLASK_DEBUG=False

# 2. Secret Key (Generate a random 64-char hex key):
# Run locally: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_64_char_hex_secret

# 3. PostgreSQL Database URL (Render External Connection URL):
# Use the EXTERNAL connection URL provided by Render (starts with postgresql:// and ends with .render.com/dbname)
DATABASE_URL=postgresql://slc_user:JLlyWAi2mPqNPAbOmGRbNpRm8fMDOk1D@dpg-daj5eolg1s2s739ft2fg-a.oregon-postgres.render.com/slc_0i0y

# 4. Security & Cookies (HTTPS is standard on Vercel)
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_DAYS=7

# 5. File Uploads (Vercel serverless functions use /tmp for temporary storage)
UPLOAD_FOLDER=/tmp/uploads
MAX_CONTENT_LENGTH=16777216

# 6. Rate Limiting Defaults
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_CHAT=1/second
RATE_LIMIT_AI=10/minute

# 7. AI Assistant Configuration (Optional)
# Options: 'heuristic' (default offline built-in), 'openai', or 'gemini'
AI_PROVIDER=heuristic
OPENAI_API_KEY=
GEMINI_API_KEY=
