# ==========================================
# Shroud's Lockin Crib (SLC) — Render Environment Variables
# ==========================================
# Copy the variables below into your Render web service's "Environment" tab.
# NEVER commit actual secrets or real DATABASE_URL values to Git.
# The DATABASE_URL below is a placeholder — replace with your real Render
# PostgreSQL internal connection string.

# Flask Application Settings
FLASK_APP=manage.py
FLASK_ENV=production
FLASK_DEBUG=False

# Generate a real SECRET_KEY:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_SECRET

# ----------------------------------------------------------
# DATABASE CONFIGURATION — PostgreSQL REQUIRED in production
# ----------------------------------------------------------
# DO NOT set this to sqlite:/// in production.
# Obtain the "Internal Database URL" from your Render PostgreSQL service.
# Render provides the URL in postgres:// format — the app converts it automatically.
#
# Example format:
#   postgresql://slcuser:password@dpg-xxxx-a.oregon-postgres.render.com/slcdb
#
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE

# ----------------------------------------------------------
# UPLOADS CONFIGURATION
# ----------------------------------------------------------
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216
ALLOWED_EXTENSIONS=png,jpg,jpeg,webp,gif

# ----------------------------------------------------------
# SECURITY & SESSION CONFIGURATION
# ----------------------------------------------------------
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_DAYS=7

# ----------------------------------------------------------
# RATE LIMITING
# ----------------------------------------------------------
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_CHAT=1/second
RATE_LIMIT_AI=10/minute

# ----------------------------------------------------------
# AI ASSISTANT (optional)
# ----------------------------------------------------------
# Options: 'heuristic' (offline, no key needed), 'openai', 'gemini'
AI_PROVIDER=heuristic
OPENAI_API_KEY=
GEMINI_API_KEY=
