# ==========================================
# Shroud's Lockin Crib (SLC) - Environment Config
# ==========================================
# Copy this file to .env and configure your variables.
# NEVER commit the actual .env file with real secrets to Git.

# Flask Application Settings
FLASK_APP=manage.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-this-to-a-super-secret-random-32-byte-hex-string-in-production

# Database Configuration
# Local SQLite: sqlite:///instance/slc.sqlite3
# Production PostgreSQL: postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///instance/slc.sqlite3

# Uploads Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB max payload
ALLOWED_EXTENSIONS=png,jpg,jpeg,webp,gif

# Security & Session Configuration
SESSION_COOKIE_SECURE=False  # Set to True in production (HTTPS)
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_DAYS=7

# Rate Limiting Settings
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_CHAT=1/second
RATE_LIMIT_AI=10/minute

# AI Assistant Configuration
# Options: 'heuristic' (offline built-in), 'openai', 'gemini'
AI_PROVIDER=heuristic
OPENAI_API_KEY=
GEMINI_API_KEY=

# Server Port
PORT=5000
HOST=0.0.0.0
